{
  "name": "geode-drive-backup",
  "version": "0.1.0",
  "description": "Backup, not sync. Push your Obsidian vault to Google Drive and pull it back on a new device, with optional client-side encryption.",
  "private": true,
  "license": "MIT",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "google-drive",
    "backup",
    "encryption"
  ],
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && npm run lint && npm run test && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tools/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "version": "node tools/version-bump.mjs && git add manifest.json versions.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^20.19.9",
    "esbuild": "^0.25.8",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "obsidian": "^1.8.7",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
